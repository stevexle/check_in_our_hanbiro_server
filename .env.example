PORT=5000
NODE_ENV=development

# Database configuration
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_DATABASE=your_db_name
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SCHEMA=hanbiro

# Telegram bot configuration
